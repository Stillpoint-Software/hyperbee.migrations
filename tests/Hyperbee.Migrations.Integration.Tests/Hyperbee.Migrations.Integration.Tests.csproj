<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      Integration tests use Testcontainers and are gated by `#if INTEGRATIONS`
      so a vanilla `dotnet test` run skips them by default. Set
      `EnableIntegrationTests=true` to compile them in:
        dotnet test /p:EnableIntegrationTests=true
      The CI workflow `.github/workflows/multi_node_tests.yml` sets this for
      multi-node-tagged tests on every PR (R-28b).
    -->
    <DefineConstants Condition="'$(EnableIntegrationTests)' == 'true'">$(DefineConstants);INTEGRATIONS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Couchbase.Extensions.DependencyInjection" />
    <PackageReference Include="CouchbaseNetClient" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MongoDB.Driver"  />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Aerospike.Client" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="OpenSearch.Client" />
    <PackageReference Include="OpenSearch.Net" />
    <PackageReference Include="Testcontainers"  />
    <PackageReference Include="Testcontainers.Couchbase"  />
    <PackageReference Include="Testcontainers.MongoDb"/>
    <PackageReference Include="Testcontainers.PostgreSql"  />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Using Include="System.Data" />
    <Using Include="DotNet.Testcontainers.Networks" />
    <Using Include="MongoDB.Driver" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hyperbee.Migrations\Hyperbee.Migrations.csproj" />
    <ProjectReference Include="..\..\src\Hyperbee.Migrations.Providers.Postgres\Hyperbee.Migrations.Providers.Postgres.csproj" />
    <ProjectReference Include="..\..\src\Hyperbee.Migrations.Providers.MongoDB\Hyperbee.Migrations.Providers.MongoDB.csproj" />
    <ProjectReference Include="..\..\src\Hyperbee.Migrations.Providers.Aerospike\Hyperbee.Migrations.Providers.Aerospike.csproj" />
    <ProjectReference Include="..\..\src\Hyperbee.Migrations.Providers.Couchbase\Hyperbee.Migrations.Providers.Couchbase.csproj" />
    <ProjectReference Include="..\..\src\Hyperbee.Migrations.Providers.OpenSearch\Hyperbee.Migrations.Providers.OpenSearch.csproj" />
    <!--
      SquashCli packages are referenced directly so end-to-end tests can
      instantiate the {Provider}SquashCliProvider types. Sample assemblies
      are NOT project references because their `Hyperbee.Migrations.{Provider}.*`
      namespaces shadow the corresponding SDK namespaces (e.g.,
      `Hyperbee.Migrations.OpenSearch.Samples` shadows `OpenSearch.Net` from
      the test files' resolution scope). Integration tests load sample
      assemblies by DLL path via Assembly.LoadFrom; the sample csprojs are
      registered as MSBuild targets that copy their output next to the test
      binary on build.
    -->
    <ProjectReference Include="..\..\src\Hyperbee.Migrations.Providers.Postgres.SquashCli\Hyperbee.Migrations.Providers.Postgres.SquashCli.csproj" />
    <ProjectReference Include="..\..\src\Hyperbee.Migrations.Providers.Aerospike.SquashCli\Hyperbee.Migrations.Providers.Aerospike.SquashCli.csproj" />
    <ProjectReference Include="..\..\src\Hyperbee.Migrations.Providers.OpenSearch.SquashCli\Hyperbee.Migrations.Providers.OpenSearch.SquashCli.csproj" />
    <ProjectReference Include="..\..\src\Hyperbee.Migrations.Providers.MongoDB.SquashCli\Hyperbee.Migrations.Providers.MongoDB.SquashCli.csproj" />
    <ProjectReference Include="..\..\src\Hyperbee.Migrations.Providers.Couchbase.SquashCli\Hyperbee.Migrations.Providers.Couchbase.SquashCli.csproj" />
    <!-- Sample project references with ReferenceOutputAssembly=false:
         triggers MSBuild build ordering (samples build before this test
         project) without bringing their compile-time types into our
         namespace lookup scope. -->
    <ProjectReference Include="..\..\runners\samples\Hyperbee.Migrations.Postgres.Samples\Hyperbee.Migrations.Postgres.Samples.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\runners\samples\Hyperbee.Migrations.Aerospike.Samples\Hyperbee.Migrations.Aerospike.Samples.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\runners\samples\Hyperbee.Migrations.OpenSearch.Samples\Hyperbee.Migrations.OpenSearch.Samples.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\runners\samples\Hyperbee.Migrations.MongoDB.Samples\Hyperbee.Migrations.MongoDB.Samples.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\runners\samples\Hyperbee.Migrations.Couchbase.Samples\Hyperbee.Migrations.Couchbase.Samples.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.CodeAnalysis.CSharp.Scripting" />
    <PackageReference Update="Microsoft.SourceLink.GitHub" >
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
