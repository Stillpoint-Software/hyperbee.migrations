{
  "statements": [
    {
      "statement": "CREATE INDEX sample_users IF NOT EXISTS WITH BODY $usersIndex",
      "bodies": {
        "usersIndex": {
          "settings": {
            "number_of_shards": 1,
            "number_of_replicas": 0
          },
          "mappings": {
            "properties": {
              "id":    { "type": "keyword" },
              "email": { "type": "keyword" },
              "name":  { "type": "text" },
              "active":{ "type": "boolean" }
            }
          }
        }
      }
    },
    { "statement": "WAIT FOR YELLOW ON sample_users TIMEOUT 30s" }
  ]
}
