-- Initial sample_users index with a tight strict mapping.
-- Authored in the recommended .pql script form (BODIES header carrying the
-- index body, multi-statement, semicolon-terminated). The legacy
-- .statements.json form remains supported for backward compatibility but is
-- not the recommended way to author new migrations.

BODIES {
  usersIndex: {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "properties": {
        "id":     { "type": "keyword" },
        "email":  { "type": "keyword" },
        "name":   { "type": "text"    },
        "active": { "type": "boolean" }
      }
    }
  }
}

CREATE INDEX sample_users IF NOT EXISTS WITH BODY $usersIndex;

-- Wait until the index reaches yellow before dispatching the next statement;
-- avoids spurious "no shard available" errors on tight CI runners.
WAIT FOR YELLOW ON sample_users TIMEOUT 30s;
