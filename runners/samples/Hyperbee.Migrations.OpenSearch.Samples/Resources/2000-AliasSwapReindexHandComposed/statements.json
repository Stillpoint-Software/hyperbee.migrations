{
  "statements": [
    {
      "statement": "CREATE INDEX sample_logs_v1 IF NOT EXISTS WITH BODY $logsV1",
      "bodies": {
        "logsV1": {
          "settings": { "number_of_shards": 1, "number_of_replicas": 0 },
          "mappings": {
            "properties": {
              "@timestamp": { "type": "date" },
              "msg":        { "type": "text" }
            }
          }
        }
      }
    },
    {
      "statement": "CREATE INDEX sample_logs_v2 IF NOT EXISTS WITH BODY $logsV2",
      "bodies": {
        "logsV2": {
          "settings": { "number_of_shards": 1, "number_of_replicas": 0 },
          "mappings": {
            "properties": {
              "@timestamp": { "type": "date" },
              "msg":        { "type": "text" },
              "level":      { "type": "keyword" }
            }
          }
        }
      }
    },
    { "statement": "ALIAS ADD sample_logs ON sample_logs_v1" },
    { "statement": "REINDEX FROM sample_logs_v1 TO sample_logs_v2" },
    { "statement": "ALIAS SWAP sample_logs FROM sample_logs_v1 TO sample_logs_v2" }
  ]
}
