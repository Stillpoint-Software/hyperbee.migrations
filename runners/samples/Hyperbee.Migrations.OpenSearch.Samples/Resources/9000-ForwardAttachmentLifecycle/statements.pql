-- Forward-attachment lifecycle for greenfield pipelines.
-- Authored in the recommended .pql script form (multi-statement, semicolon-
-- terminated). The legacy .statements.json form remains supported for
-- backward compatibility but is not the recommended way to author new
-- migrations.

-- Shared mappings + settings extracted as a component template. Indices that
-- match the next statement's index_patterns will compose this in.
CREATE COMPONENT sample_app_events_mappings WITH BODY @bodies/component.json;

-- Index template with `aliases:` block - the cluster wires the alias
-- automatically when a matching index is created. No runtime ALIAS ADD needed.
CREATE TEMPLATE sample_app_events WITH BODY @bodies/template.json;

-- ISM policy with `ism_template.index_patterns` - the cluster attaches this
-- policy to any matching index at creation time. No runtime APPLY POLICY needed.
CREATE POLICY sample_app_events_lifecycle WITH BODY @bodies/policy.json;
