-- MIGRATE INDEX composite verb.
-- Authored in the recommended .pql script form (BODIES header + multi-
-- statement, semicolon-terminated). The legacy .statements.json form remains
-- supported for backward compatibility but is not the recommended way to
-- author new migrations.

BODIES {
  ordersV1: {
    "settings": { "number_of_shards": 1, "number_of_replicas": 0 },
    "mappings": {
      "properties": {
        "id":     { "type": "keyword" },
        "amount": { "type": "double" }
      }
    }
  }
  tpl: {
    "index_patterns": ["sample_orders_v*"],
    "template": {
      "settings": { "number_of_shards": 1, "number_of_replicas": 0 },
      "mappings": {
        "properties": {
          "id":       { "type": "keyword" },
          "amount":   { "type": "double" },
          "currency": { "type": "keyword" }
        }
      }
    },
    "priority": 100
  }
}

CREATE INDEX sample_orders_v1 IF NOT EXISTS WITH BODY $ordersV1;
ALIAS ADD sample_orders ON sample_orders_v1;
CREATE TEMPLATE sample_orders_template WITH BODY $tpl;
MIGRATE INDEX sample_orders_v1 TO sample_orders_v2 WITH TEMPLATE sample_orders_template VIA ALIAS sample_orders;
