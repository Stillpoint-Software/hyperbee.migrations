-- Phase 4 sample: secondary indexes for the application's queries.
-- Demonstrates the .statements script form per ADR-0022; the .statements.json
-- form remains supported for backward compatibility.

CREATE INDEX WAIT idx_users_role ON test.users (role) STRING;

-- Product-search indexes for category browsing and price filters.
CREATE INDEX WAIT idx_products_category ON test.products (category) STRING;
CREATE INDEX WAIT idx_products_price    ON test.products (price)    NUMERIC;
